{:paths ["src"]
 :tasks
 {test:bb {:doc "Run the tests on babashka's built-in babashka.ffi. Pass --nses or --vars to select."
           :extra-paths ["test"]
           :extra-deps {io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1"
                         :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
           :task (exec 'cognitect.test-runner.api/test)
           :exec-args {:dirs ["test"]}
           :org.babashka/cli {:coerce {:nses [:symbol] :vars [:symbol]}}}
  test:polling {:doc "Run the tests on babashka with the polling backend, the one every OS shares."
                :extra-paths ["test"]
                :extra-deps {io.github.cognitect-labs/test-runner
                             {:git/tag "v0.5.1"
                              :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
                :task (do (System/setProperty "filewatcher.test.polling" "true")
                          (exec 'cognitect.test-runner.api/test))
                :exec-args {:dirs ["test"]}
                :org.babashka/cli {:coerce {:nses [:symbol] :vars [:symbol]}}}
  test:jvm {:doc "Run the tests on the JVM, with babashka.ffi from git."
            :task (shell "clojure -M:test")}}}
