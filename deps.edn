{:paths ["src"]
 ;; On babashka the library is built in; on the JVM it comes from the
 ;; babashka/ffi repository.
 :deps {io.github.babashka/ffi
        {:git/url "https://github.com/babashka/ffi"
         :git/sha "e7ac217bf8c9619574a4420501ac2d00388d6e43"}
        babashka/fs {:mvn/version "0.5.27"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1"
                       :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}}}
