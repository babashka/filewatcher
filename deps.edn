{:paths ["src"]
 ;; On babashka the library is built in; on the JVM it comes from the
 ;; babashka/ffi repository.
 :deps {io.github.babashka/ffi
        {:git/url "https://github.com/babashka/ffi"
         :git/sha "1cde4ddd02d7f8eee780d75cf5e38f61ade697b1"}
        babashka/fs {:mvn/version "0.5.27"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1"
                       :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}}}
